rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regras de Usuários: leitura pública, edição apenas pelo próprio usuário
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Regras de Perguntas: leitura pública para todo mundo jogar
    match /questions/{questionId} {
      allow read: if true;
      allow write: if request.auth != null; // apenas admins ou autenticados
    }

    // Regras de Resultados: criação livre para salvar a partida
    match /quiz_results/{resultId} {
      allow create: if true;
      allow read: if true;
    }

    // Regras de Leaderboards / Rankings: leitura pública para o placar, escrita liberada para salvar pontuações
    match /leaderboards/{leaderboardType}/entries/{userId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
